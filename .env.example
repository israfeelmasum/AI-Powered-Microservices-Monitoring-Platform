# ── Admin Credentials ─────────────────────────────────────────────────────────
# Change these before running in any environment
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ── Master Secret Key ──────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key

# ── Elasticsearch ──────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── Ollama (Local AI) ──────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434

# ── Service Secrets ────────────────────────────────────────────────────────────
# Generate unique secrets for each microservice:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
NOTE_SERVICE_SECRET=change-this-note-secret
USER_SERVICE_SECRET=change-this-user-secret
ORDER_SERVICE_SECRET=change-this-order-secret
PAYMENT_SERVICE_SECRET=change-this-payment-secret
INVENTORY_SERVICE_SECRET=change-this-inventory-secret
