# ── Note Service Configuration ─────────────────────────────────────────────────
PORT=8001
HOST=0.0.0.0
DEBUG=false
ENVIRONMENT=development

# ── Monitoring Core Connection ─────────────────────────────────────────────────
MONITORING_URL=http://localhost:8000
# Must match NOTE_SERVICE_SECRET in monitoring-core .env
NOTE_SERVICE_SECRET=change-this-note-secret
# Must match ADMIN_USERNAME / ADMIN_PASSWORD in monitoring-core .env
MONITORING_ADMIN_USERNAME=admin
MONITORING_ADMIN_PASSWORD=change-this-password

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/notes.db

# ── Performance ────────────────────────────────────────────────────────────────
REQUEST_TIMEOUT=30
MAX_CONNECTIONS=100
